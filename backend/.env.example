# Database
POSTGRES_DSN=postgresql://postgres:password$1@192.168.9.227:5439/sultan_assistant

# LLM Gateway
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=test123
LLM_MODEL=gpt-4.1-mini

# Google OAuth
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# NextAuth (for JWT validation)
NEXTAUTH_SECRET=your-nextauth-secret

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Sync Settings
SYNC_INTERVAL_MINUTES=15
SYNC_EMAIL_MAX_RESULTS=100
SYNC_CALENDAR_DAYS_AHEAD=30

# Feature Flags
FEATURE_TAIGA_ENABLE=false
FEATURE_EMAIL_NOTIFY=true
FEATURE_CALENDAR_NOTIFY=true

# App Settings
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
